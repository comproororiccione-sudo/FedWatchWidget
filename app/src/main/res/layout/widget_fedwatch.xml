<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:background="@drawable/widget_background"
    android:padding="14dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="FED FUNDS WATCH" android:textStyle="bold" android:textColor="@color/widget_text" android:textSize="15sp"/>
        <TextView android:id="@+id/refresh" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="↻" android:textColor="@color/widget_accent" android:textSize="22sp" android:paddingLeft="12dp"/>
    </LinearLayout>

    <TextView android:id="@+id/meeting" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="FOMC • 16 SET 2026" android:textColor="@color/widget_muted" android:textSize="12sp" android:paddingTop="2dp"/>

    <TextView android:id="@+id/primary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Caricamento…" android:textStyle="bold" android:textColor="@color/widget_text" android:textSize="22sp" android:paddingTop="12dp"/>
    <TextView android:id="@+id/secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="@color/widget_text" android:textSize="16sp" android:paddingTop="4dp"/>

    <TextView android:id="@+id/rates" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="@color/widget_muted" android:textSize="11sp" android:paddingTop="9dp"/>
    <TextView android:id="@+id/updated" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="@color/widget_muted" android:textSize="10sp" android:paddingTop="5dp"/>
</LinearLayout>
